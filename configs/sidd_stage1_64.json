{
  "dataset": "SIDD",
  "data_chain": "bilinear256",
  "patch_size": 64,
  "batch_size": 8,
  "epochs": 30,
  "optimizer": {
    "name": "AdamW",
    "learning_rate": 0.00001
  },
  "loss": {
    "name": "ResidualFDPL",
    "vgg_weight": 0.01,
    "max_fdpl_weight": 0.08,
    "warmup_epochs": 5,
    "target_ratio": 0.30
  },
  "calibration": {
    "batches": 32,
    "every_epochs": 5
  },
  "weight_map": {
    "pairs": 15000,
    "batch_size": 8,
    "form": "log_inv",
    "clip_quantile": 0.01,
    "power": false
  },
  "seed": 42
}
